{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "used-lab-next",
  // node:fs などの Node.js API を使うため nodejs_compat が必須。
  // 2025-09-01 以降の compatibility_date で node:fs が既定で有効になる
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare Images の変換を使う（image-loader.ts）
  "images": {
    "binding": "IMAGES"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // ISR の再生成でワーカーが自分自身を呼ぶために必要
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "used-lab-next" }
  ],
  // 増分キャッシュの保存先。R2 バケットは事前に作成しておくこと
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "used-lab-next-cache" }
  ],
  // revalidateTag のタグ管理。これが無いと OpenNext は tagCache を "dummy" に
  // フォールバックし、writeTags が何もせず isStale が常に false を返すため、
  // revalidateTag を呼んでもページが永久に再生成されない。
  // このサイトは時間ベースの再生成を使わず revalidateTag だけで更新するので必須。
  // binding 名は d1NextTagCache が参照する固定値（変更不可）。
  // テーブルは `opennextjs-cloudflare deploy` が作成する。`wrangler deploy` では
  // 作られないので、デプロイは必ず npm run deploy:cf を使うこと。
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "used-lab-next-tag-cache",
      "database_id": "9822936b-c1c9-4970-a76a-ddabb371811c"
    }
  ]
}
